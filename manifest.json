{
  "manifest_version": 3,
  "name": "Panopto Course Filter",
  "version": "0.1.0",
  "description": "Filter Auburn Panopto recordings by course.",
  "content_scripts": [
    {
      "matches": ["https://auburn.hosted.panopto.com/*"],
      "js": ["content.js", "content-fixes.js", "course-discovery-fix.js", "course-discovery-v3.js", "course-list-fix.js"],
      "css": ["styles.css", "settings.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "action": {
    "default_title": "Panopto Course Filter"
  }
}
